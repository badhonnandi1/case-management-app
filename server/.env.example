# Backend-only provider secrets. Never commit real values and never expose them
# through EXPO_PUBLIC_* variables. For Cloudflare, set them with
# `npx wrangler secret put VARIABLE_NAME` instead of copying this file.
GEMINI_API_KEY=replace_with_google_ai_studio_key
GROQ_API_KEY=replace_with_groq_console_key

# Production also requires an independent base64url session-signing secret with
# at least 32 random bytes. Generate it securely; never reuse a provider key.
# SESSION_SIGNING_SECRET=replace_with_base64url_32_byte_secret

# Provider policy. Worker clients see only AI_PUBLIC_MODEL_ID/NAME; provider
# model IDs remain backend-only settings so future changes need no APK rebuild.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_PUBLIC_MODEL_ID=balanced
AI_PUBLIC_MODEL_NAME=Balanced
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_FALLBACK_ENABLED=true
AI_ONLINE_ENABLED=true
AI_PRIVACY_POLICY_ID=free-providers-selected-excerpts-2026-09-04
AI_CONSENT_POLICY_VERSION=2026-09-04-free-providers-selected-excerpts-v2

PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Legacy Fastify only: comma-separated web origins. The Worker rejects every
# browser Origin because the testing client is native Android.
ALLOWED_ORIGINS=https://app.example.com

# Conservative testing limits. The Worker enforces all answer counters in D1.
ANSWER_RATE_LIMIT_PER_MINUTE=3
IP_RATE_LIMIT_PER_MINUTE=10
SESSION_ISSUE_LIMIT_PER_MINUTE=5
AI_DAILY_PER_TESTER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=50
AI_MAX_OUTPUT_TOKENS=1024
SESSION_TTL_SECONDS=900
PROVIDER_TIMEOUT_MS=30000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=2
PROVIDER_CIRCUIT_OPEN_SECONDS=30
TRUST_PROXY=false
