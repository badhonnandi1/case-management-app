# Required only for live Gemini requests. Never commit the real value.
GEMINI_API_KEY=replace_with_backend_secret

# Production also requires an independent base64url session-signing secret with
# at least 32 random bytes. Generate it securely; never reuse the Gemini key.
# SESSION_SIGNING_SECRET=<secure backend-only Render Dashboard value>

# Stable, structured-output-capable model verified on 2026-09-04.
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
AI_ONLINE_ENABLED=true
AI_PRIVACY_POLICY_ID=gemini-free-selected-excerpts-2026-09-04
AI_CONSENT_POLICY_VERSION=2026-09-04-gemini-free-selected-excerpts-v1

PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated web origins. Native Android requests normally have no Origin.
ALLOWED_ORIGINS=https://app.example.com

# Single-instance in-memory limits. Use a shared gateway/store before scaling out.
ANSWER_RATE_LIMIT_PER_MINUTE=10
IP_RATE_LIMIT_PER_MINUTE=30
SESSION_ISSUE_LIMIT_PER_MINUTE=10
SESSION_TTL_SECONDS=900
PROVIDER_TIMEOUT_MS=30000
TRUST_PROXY=false
