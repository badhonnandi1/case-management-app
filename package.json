{
  "name": "case-management-app",
  "version": "1.1.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test:sqlite": "node scripts/sqlite-contract.test.mjs",
    "test:pure": "node scripts/pure-logic.test.mjs",
    "test:backup": "node scripts/backup-restore.test.mjs",
    "test:offline": "node scripts/offline-tools.test.mjs",
    "test:ai": "node scripts/ai-foundation.test.mjs",
    "test:ai-ui": "node scripts/ai-ui.test.mjs",
    "test:ai-online": "node --import ./server/node_modules/tsx/dist/loader.mjs scripts/ai-online.test.mjs",
    "test:ai-chat": "node --import ./server/node_modules/tsx/dist/loader.mjs scripts/ai-chat.test.mjs",
    "test:production": "node --import ./server/node_modules/tsx/dist/loader.mjs scripts/production-readiness.test.mjs",
    "server:check": "npm --prefix server run check",
    "server:test": "npm --prefix server test",
    "server:build": "npm --prefix server run build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.0.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-intent-launcher": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
